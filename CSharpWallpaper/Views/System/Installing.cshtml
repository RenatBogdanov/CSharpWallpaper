@model dynamic
@{
    ViewData["Title"] = "Установка обоев";
}

<div class="container text-center" style="margin-top: 50px;">
    <div class="row">
        <!-- Левая колонка -->
        <div class="col-md-6 mb-4">
            <div class="preview-card" style="border: 3px solid #6F5B42;">
                <div class="preview-image-wrapper">
                    <img src="/Installing/GetCurrentWallpaperImage"
                         alt="Текущие обои"
                         onerror="this.src='https://placehold.co/600x400/B5A892/15160A?text=No+Image'" />
                </div>
                <div class="preview-card-content">
                    <h4 class="preview-card-title">Текущие обои</h4>
                    <p class="preview-card-text">Путь в системе:</p>
                    <p class="preview-card-path">@ViewBag.CurrentWallpaperPath</p>
                </div>
            </div>
        </div>

        <!-- Правая колонка -->
        <div class="col-md-6 mb-4">
            @if (ViewBag.ImageUrl != null)
            {
                <div class="preview-card" style="border: 3px solid #FFD700;">
                    <div class="preview-image-wrapper">
                        <img src="@ViewBag.ImageUrl"
                             id="wallpaperPreview"
                             alt="Новые обои" />
                    </div>
                    <div class="preview-card-content">
                        <h4 class="preview-card-title">Выбранные обои</h4>
                        <p class="preview-card-text">Готовы к установке на рабочий стол</p>
                        <button id="setBtn" class="btn btn-primary btn-lg w-100" onclick="setWallpaper('@ViewBag.ImageUrl')">
                            Подтвердить замену
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="preview-placeholder">
                    <div class="placeholder-content">
                        <div class="placeholder-icon">🖼️</div>
                        <p class="placeholder-text">Картинка не выбрана</p>
                        <p class="placeholder-subtext">Вернитесь на главную страницу для выбора обоев</p>
                    </div>
                </div>
            }
        </div>
    </div>


</div>

<script>
    async function setWallpaper(url) {
        const btn = document.getElementById('setBtn');
        const oldText = btn.innerText;

        btn.disabled = true;
        btn.innerText = "Установка...";

        try {
            const response = await fetch('/Installing/Set?imageUrl=' + encodeURIComponent(url), {
                method: 'POST'
            });

            if (response.ok) {
                alert("Обои успешно установлены!");
                location.reload();
            } else {
                alert("Ошибка при установке. Убедитесь, что файл существует в папке wwwroot.");
            }
        } catch (error) {
            alert("Произошла ошибка при отправке запроса.");
        } finally {
            btn.disabled = false;
            btn.innerText = oldText;
        }
    }
</script>