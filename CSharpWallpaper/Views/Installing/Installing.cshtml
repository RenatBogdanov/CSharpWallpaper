@model dynamic
@{
    ViewData["Title"] = "Установка обоев";
}

<div class="container text-center" style="margin-top: 50px;">
    <div class="container text-center" style="margin-top: 50px;">
        <div class="row">
            <!-- Левая колонка -->
            <div class="col-md-6">
                <h3 class="installing-section-title">Сейчас на рабочем столе:</h3>
                <div class="preview-container" style="border: 2px solid #ddd; border-radius: 12px; padding: 15px; background: #f9f9f9;">
                    <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: 8px; background: #eee; display: flex; align-items: center; justify-content: center;">
                        <img src="/Installing/GetCurrentWallpaperImage"
                             alt="Текущие обои"
                             style="width: 100%; height: 100%; object-fit: cover;"
                             onerror="this.src='https://placehold.co'" />
                    </div>
                    <p style="font-size: 0.75rem; color: #888; margin-top: 15px; word-break: break-all;">
                        Путь в системе: <br /> <strong>@ViewBag.CurrentWallpaperPath</strong>
                    </p>
                </div>
            </div>

            <!-- Правая колонка -->
            <div class="col-md-6">
                <h3 class="installing-section-title">Будет установлено:</h3>
                @if (ViewBag.ImageUrl != null)
                {
                    <div class="preview-container" style="border: 2px solid #007bff; border-radius: 12px; padding: 15px; background: #f0f7ff;">
                        <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: 8px; background: #eee;">
                            <img src="@ViewBag.ImageUrl" id="wallpaperPreview" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <button id="setBtn" class="btn btn-primary btn-lg w-100" style="margin-top: 15px;" onclick="setWallpaper('@ViewBag.ImageUrl')">
                            Подтвердить замену
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" style="display: flex; align-items: center; justify-content: center; min-height: 300px;">
                        Картинка не выбрана. Вернитесь на главную.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    async function setWallpaper(url) {
        const btn = document.getElementById('setBtn');
        const oldText = btn.innerText;

        btn.disabled = true;
        btn.innerText = "Установка...";

        try {
            const response = await fetch('/Installing/Set?imageUrl=' + encodeURIComponent(url), {
                method: 'POST'
            });

            if (response.ok) {
                alert("Обои успешно установлены!");
                location.reload();
            } else {
                alert("Ошибка при установке. Убедитесь, что файл существует в папке wwwroot.");
            }
        } catch (error) {
            alert("Произошла ошибка при отправке запроса.");
        } finally {
            btn.disabled = false;
            btn.innerText = oldText;
        }
    }
</script>